{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASS}"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "MyMicroservice",
    "Audience": "MyMicroserviceUsers",
    "ExpirationMinutes": 30
  }
}